# Copy this file to dev/.env (optional - defaults work without it)

PAYLOAD_SECRET=dev-only-secret-change-me
# SQLite file, relative to the plugin repo root (the scripts run from there)
DATABASE_URI=file:./dev/dev.db

# Google Cloud credentials (see ../README.md). Leave empty to run the dev
# instance with the plugin in "disabled" mode (no import button).
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_PROJECT_NUMBER=
